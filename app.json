{
  "expo": {
    "name": "JTA",
    "slug": "sales-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0D",
    "scheme": "salescrm",
    "ios": {
      "bundleIdentifier": "com.salescrm.app"
    },
    "android": {
      "package": "com.salescrm.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0B0C0D"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow JTA to record voice notes for your meetings.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow JTA to take a check-in selfie.",
          "photosPermission": "Allow JTA to attach photos to meetings."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow JTA to verify your location at check-in."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "16cdd5d9-bc42-4246-9783-d189724603a2"
      }
    },
    "owner": "ayush_chaudhari",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/16cdd5d9-bc42-4246-9783-d189724603a2"
    }
  }
}

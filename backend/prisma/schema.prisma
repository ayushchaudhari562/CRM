// Sales Visit CRM - database schema (MVP only).
// Not in MVP (do not add yet): orders, payments, route plans, leaderboard, fake-GPS detection, card scan, exports.
//
// Conventions:
// - ids are cuid strings (safe to create on the phone for the offline queue).
// - all times are stored in UTC (timestamptz).
// - money is Decimal(12,2) in INR (never Float).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL lives in prisma.config.ts (Prisma 7).
}

// ---------- Enums ----------

enum Role {
  SALESMAN
  ADMIN
}

enum MeetingOutcome {
  INTERESTED
  CLOSED
  NOT_INTERESTED
}

enum AttachmentType {
  PHOTO
  FILE
}

enum FollowUpType {
  VISIT
  CALL
}

// "Overdue" is not stored: it is status = PENDING and dueAt < now().
enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

// ---------- People ----------

model User {
  id         String   @id @default(cuid())
  // Supabase Auth user id (auth.users.id). Set after the first OTP login.
  authUserId String?  @unique @db.Uuid
  name       String
  phone      String   @unique // E.164, e.g. +919876543210. Used for OTP login.
  employeeId String?  @unique
  role       Role     @default(SALESMAN)
  isActive   Boolean  @default(true) // deactivate instead of delete, to keep history
  // WhatsApp reminders: on by default (work app); the salesman can opt out (app or "STOP").
  whatsappOptOut   Boolean   @default(false)
  whatsappOptOutAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  clients       Client[]
  meetings      Meeting[]
  followUps     FollowUp[]
  attendance    Attendance[]
  targets       Target[]
  locationPings LocationPing[]
  sessions      Session[]
  weeklyPlans   WeeklyPlan[]
}

// ---------- Clients ----------

// A client (shop/business) belongs to one salesman. A salesman sees only their own clients.
model Client {
  id            String   @id @default(cuid())
  salesmanId    String
  name          String
  businessType  String
  contactNumber String?
  address       String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  salesman  User       @relation(fields: [salesmanId], references: [id], onDelete: Restrict)
  meetings  Meeting[]
  followUps FollowUp[]

  @@index([salesmanId, name])
}

model Product {
  id       String    @id @default(cuid())
  name     String    @unique
  isActive Boolean   @default(true)
  meetings Meeting[] // implicit many-to-many
}

// ---------- Visits ----------

// One visit to a client: check-in (selfie + GPS + time) -> form -> check-out.
model Meeting {
  id              String @id @default(cuid())
  // Set by the phone when the visit is created offline. Same id sent twice = same meeting (no duplicates on sync).
  clientRequestId String @unique
  salesmanId      String
  clientId        String

  // Check-in
  checkInAt       DateTime  @db.Timestamptz(3)
  checkInLat      Float? // null when GPS permission was denied
  checkInLng      Float?
  checkInAccuracy Float? // metres
  checkInAddress  String? // street address looked up on the phone at check-in
  selfieUrl       String? // storage path, not a public URL
  checkOutAt      DateTime? @db.Timestamptz(3)

  // Form
  outcome          MeetingOutcome
  dealValue        Decimal        @default(0) @db.Decimal(12, 2)
  note             String? // typed note
  voiceNoteUrl     String?
  voiceNoteSeconds Int?
  aiSummary        String? // placeholder now, filled by an LLM job later
  nextVisitAt      DateTime?      @db.Timestamptz(3)
  whatsappReminder Boolean        @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3) // when the server received it
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  salesman    User         @relation(fields: [salesmanId], references: [id], onDelete: Restrict)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  products    Product[]
  attachments Attachment[]
  followUps   FollowUp[]

  @@index([salesmanId, checkInAt])
  @@index([clientId, checkInAt])
  @@index([checkInAt])
}

model Attachment {
  id        String         @id @default(cuid())
  meetingId String
  type      AttachmentType
  url       String // storage path
  name      String
  sizeBytes Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

// ---------- Follow-ups ----------

model FollowUp {
  id             String         @id @default(cuid())
  salesmanId     String
  clientId       String
  meetingId      String? // the visit that created it (null if added by hand)
  type           FollowUpType   @default(VISIT)
  dueAt          DateTime       @db.Timestamptz(3)
  status         FollowUpStatus @default(PENDING)
  whatsappSentAt DateTime?      @db.Timestamptz(3) // reminder delivered to WhatsApp
  // Reminder job bookkeeping (claim -> send -> retry with backoff -> give up).
  reminderClaimedAt DateTime? @db.Timestamptz(3) // being sent; older than 5 min = crashed run, retried
  reminderAttempts  Int       @default(0)
  reminderNextAt    DateTime? @db.Timestamptz(3) // retry not before
  reminderError     String?
  reminderFailedAt  DateTime? @db.Timestamptz(3) // gave up (bad number, template rejected, 8 tries)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  salesman User     @relation(fields: [salesmanId], references: [id], onDelete: Restrict)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  meeting  Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([salesmanId, status, dueAt]) // "due today" and "overdue" lists
  @@index([status, dueAt])
}

// ---------- Field tracking ----------

// Punch in / punch out for a working day.
model Attendance {
  id          String    @id @default(cuid())
  salesmanId  String
  punchInAt   DateTime  @db.Timestamptz(3)
  punchInLat  Float?
  punchInLng  Float?
  punchOutAt  DateTime? @db.Timestamptz(3)
  punchOutLat Float?
  punchOutLng Float?

  salesman User @relation(fields: [salesmanId], references: [id], onDelete: Restrict)

  @@index([salesmanId, punchInAt])
}

// Last known position, for the admin live monitoring screen. Only sent while punched in.
model LocationPing {
  id         String   @id @default(cuid())
  salesmanId String
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime @db.Timestamptz(3)

  salesman User @relation(fields: [salesmanId], references: [id], onDelete: Cascade)

  @@index([salesmanId, recordedAt])
}

// Daily target per salesman.
model Target {
  id              String   @id @default(cuid())
  salesmanId      String
  date            DateTime @db.Date
  visitsTarget    Int
  dealValueTarget Decimal? @db.Decimal(12, 2)

  salesman User @relation(fields: [salesmanId], references: [id], onDelete: Cascade)

  @@unique([salesmanId, date])
}

// ---------- Login (OTP on our server) ----------

// One OTP sent to a phone. Only an HMAC of the code is stored. A newer OTP or a correct entry sets usedAt.
// Rows are also written for unknown numbers (never sent), so limits and answers are the same for everyone.
model OtpCode {
  id        String    @id @default(cuid())
  phone     String // E.164
  codeHash  String
  attempts  Int       @default(0) // wrong entries (max 5)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

// A logged-in phone. The refresh token is random; only its SHA-256 is stored, and it changes on every refresh.
// No time limit: it ends only on logout, "log out everywhere" or when the admin deactivates the user.
model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  prevTokenHash String?   @unique // the token before the last refresh (accepted for 10 min if the answer was lost)
  rotatedAt     DateTime? @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// Who did what: OTP sent / login / logout / deactivate / WhatsApp opt-in, opt-out. Never deleted.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------- Weekly Route Plan ----------

enum PlannedStopStatus {
  PENDING
  VISITED
  MISSED
}

model WeeklyPlan {
  id         String   @id @default(cuid())
  salesmanId String
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  salesman   User          @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  stops      PlannedStop[]

  @@unique([salesmanId, date])
  @@index([salesmanId, date])
}

model PlannedStop {
  id               String            @id @default(cuid())
  planId           String
  clientName       String
  location         String
  contactNumber    String?
  status           PlannedStopStatus @default(PENDING)
  visitedMeetingId String?
  visitedAt        DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  plan             WeeklyPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
}

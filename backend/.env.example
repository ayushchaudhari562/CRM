# Copy this file to .env and fill in real values. Never commit .env.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase dashboard -> Connect -> ORMs -> Prisma
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# TEMPORARY dev login (fixed OTP). Leave empty in production.
DEV_LOGIN_OTP=
DEV_JWT_SECRET=
# Production only: comma-separated web origins allowed to call the API (unset = any)
CORS_ORIGINS=
# File storage (server only, NEVER in the app). Supabase -> Project Settings -> API keys -> secret / service_role.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=visit-files
# OTP login on our server: random secret, at least 32 characters (e.g. `openssl rand -hex 32`). Empty = OTP login off.
AUTH_SECRET=
# WhatsApp delivery (OTP + reminders). "mock" only logs and never sends; reminders run only with a real provider.
MESSAGING_PROVIDER=mock
# Needed when MESSAGING_PROVIDER=twilio. Content SIDs are the approved templates (HX...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_OTP_CONTENT_SID=
TWILIO_REMINDER_CONTENT_SID=
